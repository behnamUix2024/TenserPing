<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/img_"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07223E">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@drawable/bg" />


    <ImageView
        android:id="@+id/img_rotate_phone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"

        android:contentDescription="TODO"
        android:src="@drawable/rotate_tilt"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ip"
        app:layout_constraintEnd_toStartOf="@+id/tv_ip"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toEndOf="@+id/img_exit"
        app:layout_constraintTop_toTopOf="@+id/tv_ip" />

    <ImageView
        android:id="@+id/img_hist"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:contentDescription="TODO"
        android:src="@drawable/icon_clock_history"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ip"
        app:layout_constraintEnd_toStartOf="@+id/lav_info"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/tv_ip"
        app:layout_constraintTop_toTopOf="@+id/tv_ip" />



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_ping"
        android:layout_width="250dp"
        android:layout_height="160dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1.4"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_ip"
        app:layout_constraintStart_toStartOf="@+id/tv_ip"
        app:layout_constraintTop_toBottomOf="@+id/tv_ip"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/linearLayout6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="65dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:src="@drawable/icon_ping2"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/linearLayout4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ping"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sprint"
                    android:gravity="center"
                    android:text="----"
                    android:textColor="@color/white"
                    android:textSize="@dimen/h5" />

                <TextView
                    android:id="@+id/textView1897"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/sprint"
                    android:gravity="center"
                    android:text="m/s"
                    android:textColor="@color/white"
                    android:textSize="@dimen/body" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_ping"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2D000000"
                android:fontFamily="@font/vazir_medium"
                android:gravity="center"
                android:text="پینگ"
                android:textColor="@color/end_color"
                android:textColorLink="#00FFFFFF"
                android:textSize="@dimen/h6" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/card_download"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_margin="6dp"
        android:layout_weight="1"

        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_upload"
        app:layout_constraintEnd_toStartOf="@+id/lav_info"
        app:layout_constraintStart_toEndOf="@+id/card_ping"
        app:layout_constraintTop_toTopOf="@+id/card_upload">

        <ImageView
            android:id="@+id/img_upload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/icon_upload" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_speed_upload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="@font/sprint"
                android:gravity="center"
                android:text="--.--"
                android:textColor="@color/white"
                android:textSize="@dimen/body" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_upload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D000000"
            android:fontFamily="@font/vazir_medium"
            android:gravity="center"
            android:text="سرعت آپلود"
            android:textColor="@color/white"
            android:textColorLink="#00FFFFFF"
            android:textSize="@dimen/body" />

        <LinearLayout
            android:id="@+id/pb_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/pb_upload"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:progress="0"
                android:progressBackgroundTint="#9CCC65"
                android:progressTint="@color/end_color" />

            <TextView
                android:id="@+id/tv_pb_uplosd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:fontFamily="@font/sprint"
                android:gravity="center"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/body" />

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/card_upload"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_ping"
        app:layout_constraintEnd_toStartOf="@+id/card_ping"
        app:layout_constraintStart_toEndOf="@+id/img_exit"
        app:layout_constraintTop_toTopOf="@+id/card_ping">


        <ImageView
            android:id="@+id/img_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/icon_download" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_speed_download"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:fontFamily="@font/sprint"
                android:gravity="center"
                android:text="--.--"
                android:textColor="@color/white"
                android:textSize="@dimen/body" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D000000"
            android:fontFamily="@font/vazir_medium"
            android:gravity="center"
            android:text="سرعت دانلود"
            android:textColor="@color/white"
            android:textColorLink="#00FFFFFF"
            android:textSize="@dimen/body" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/geo_card"
        app:layout_constraintEnd_toEndOf="@+id/card_ping"
        app:layout_constraintStart_toStartOf="@+id/card_ping"
        app:layout_constraintTop_toBottomOf="@+id/card_ping">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vw_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_block"
            android:clickable="true"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toEndOf="@+id/card_ping"
            app:layout_constraintStart_toStartOf="@+id/card_ping"
            app:layout_constraintTop_toBottomOf="@+id/card_ping">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazir_bold"
                android:text="شروع"
                android:textColor="@color/white"
                android:textSize="@dimen/h6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_hist"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:backgroundTint="@color/black"
        android:clickable="true"
        android:drawableTop="@drawable/icon_clock_history"
        android:fontFamily="@font/vazir_medium"
        android:text="ذخیره در تاریخچه؟"
        android:textColor="@color/white"
        android:textSize="@dimen/small1"
        app:cornerRadius="8dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/card_download"
        app:layout_constraintStart_toStartOf="@+id/card_download"
        app:layout_constraintTop_toBottomOf="@+id/card_download" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_export_pdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:backgroundTint="@color/black"
        android:drawableTop="@drawable/icon_file_earmark_pdf"
        android:fontFamily="@font/vazir_medium"
        android:text="خروجی فایل PDF\n(به زودی)"
        android:textColor="@color/white"
        android:textSize="@dimen/body"
        android:visibility="gone"
        app:cornerRadius="8dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/lav_info" />

    <ImageView
        android:id="@+id/img_exit"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:layout_gravity="left"
        android:layout_marginStart="32dp"
        android:background="@drawable/ripple_exit_btn"
        android:backgroundTint="#333333"
        android:clickable="true"
        android:contentDescription="TODO"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_exiit2"
        app:tint="#E57373" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_info"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/ripple_info_btn"
        android:backgroundTint="#333333"
        android:elevation="6dp"
        android:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/img_exit"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_rawRes="@raw/info_anim"
        app:lottie_repeatCount="4"
        app:srcCompat="@drawable/info_circle" />

    <androidx.cardview.widget.CardView
        android:id="@+id/geo_card"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:clickable="true"
        app:cardBackgroundColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/btn_save_hist"
        app:layout_constraintEnd_toEndOf="@+id/card_upload"
        app:layout_constraintStart_toStartOf="@+id/card_upload"
        app:layout_constraintTop_toTopOf="@+id/btn_save_hist">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="57dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/icon_ethernet" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazir_fd_wol"
                android:gravity="center"
                android:text="نوع شبکه"
                android:textColor="@color/white"
                android:textSize="@dimen/body" />

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/sprint"
                android:gravity="center"
                android:text="---"
                android:textColor="#87FFFFFF"
                android:textSize="@dimen/body" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/sprint"
        android:gravity="center"
        android:text="000.000.000.000"
        android:textColor="@color/white"
        android:textSize="@dimen/h5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>